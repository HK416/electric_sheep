# The Shadow Hand cube reorientation (plan H) as a person writes it. It compiles to
# tests/fixtures/shadow-hand/task-repose.toml's task_hash (crates/es-script/tests/estask.rs);
# that document's header says why each number is what it is.
kind = "task-spec"
schema = 1
scene = "tests/fixtures/mjcf/shadow_hand/shadow_hand_repose.xml"
robot = "robot0:hand mount"
control_hz = 60
timeout_s = 8.0

# The cube turned to the goal: under 0.1 rad (5.7296 deg) between them.
[success]
clauses = [
  { subject = "object", relation = "orientation_matches", object = "target", within_deg = 5.729577951308232, shaping = "inverse_angle", weight = 1.0, term = "rotation" },
]

# The cube 0.24 m from where it rests on the palm.
[failure]
clauses = [
  { subject = "object", relation = "farther_than", point = [1.0, 0.867, 0.1772], m = 0.24, shaping = "distance", weight = -10.0, term = "cube_distance" },
]

[start]
items = [
  { what = "robot.joints", noise = 0.2, coupled = true },
  { what = "object.x", value = 1.0, noise = 0.01, stream = "cube.pos.0" },
  { what = "object.y", value = 0.867, noise = 0.01, stream = "cube.pos.1" },
  { what = "object.z", value = 0.1772, stream = "cube.pos.2" },
  { what = "object.orientation", draw = "yaw", tilt = 0.0355, stream = "cube.yaw" },
  { what = "target.orientation", draw = "yaw", tilt = 0.0355, stream = "goal.yaw" },
]

[observe]
cameras = ["top", "front", "side"]
camera_px = 96
render = { path = "pt", spp = 32, bounces = 3, exposure = 8.0, seed = "tick" }
state = { joint_pos = "robot.joint_pos", joint_vel = "robot.joint_vel", goal_pose = "target.pose", target_qpos = "target.qpos", last_action = "robot.previous_action" }
privileged = { cube_pose = "object.pose", object_vel = "object.vel" }

# Isaac Lab's terms at rl_games' scale.
[reward]
scale = 0.01
success = 250.0

# --- the other documents (packet G3b): `es project generate` writes plan H's set from here ---

# The PPO teacher reads what the simulator knows, in this order (its state vector's layout).
[teacher]
state = ["joint_pos", "joint_vel", "cube_pose", "object_vel", "goal_pose", "last_action"]

# The run plan H's E1 measured (training-teacher-v2.toml) is the preset; its bundle's name.
[teacher.training.policy]
bundle = "runs/shadow-hand/teacher-untrained-v2.esb"

# The three-view student reads the hand's joints and the goal, never the cube's pose; it
# predicts 16 rows (0.27 s) and executes 6, replanning at 10 Hz.
[student]
state = ["joint_pos", "target_qpos"]
horizon = 16
execute = 6

# Plan N's E1/E2 length: three times the preset's 20,000 steps.
[student.training.run]
steps = 60000
checkpoint_at = [1000, 5000, 20000, 60000]

[deploy]
name = "shadow_hand"
workspace = { min = [0.7, 0.5, 0.0], max = [1.3, 1.5, 0.6] }

# 64 held-out seeds, outside the cycle's 1001-1300.
[evaluate]
first_seed = 301
episodes = 64

# The teacher demonstrates 300 episodes; its successes train the student, judged on the
# nominal suite (six suites of three 32-spp cameras is ~14 h on this PC).
[cycle]
runs = "runs/shadow-hand"
episodes = 300
seed = 1001
success_only = true
nominal_only = true
jobs = 4
