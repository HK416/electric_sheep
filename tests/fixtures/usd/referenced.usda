#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Composition is out of scope: the reader must refuse this by prim path rather than import a scene that is silently missing the referenced body (spec 2.5 route: flatten with USD Bake)."
)

def Xform "World"
{
    def Xform "table" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "robot" (
        prepend references = @./franka.usda@</Franka>
    )
    {
    }
}
