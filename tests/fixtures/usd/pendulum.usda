#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Two-body revolute pendulum with a driven joint. Hand-written fixture for the M4 W3 USD reader packet; already Z-up and in metres, so the axis and unit conversions are identities here and are exercised by yup_cm.usda instead."
)

def Xform "World"
{
    def Scope "physics"
    {
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 2)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        bool physics:kinematicEnabled = true
        float physics:mass = 5

        def Cube "shell" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.2
        }
    }

    def Xform "link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        float physics:mass = 1.25
        point3f physics:centerOfMass = (0, 0, -0.25)
        float3 physics:diagonalInertia = (0.03, 0.03, 0.001)

        def Capsule "rod" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double radius = 0.05
            double height = 0.5
            uniform token axis = "Z"
        }
    }

    def PhysicsRevoluteJoint "elbow" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        rel physics:body0 = </World/base>
        rel physics:body1 = </World/link>
        point3f physics:localPos0 = (0, 0, -0.5)
        point3f physics:localPos1 = (0, 0, 0.25)
        quatf physics:localRot1 = (1, 0, 0, 0)
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
        float drive:angular:physics:stiffness = 120
        float drive:angular:physics:damping = 8
        float drive:angular:physics:targetPosition = 30
    }
}
