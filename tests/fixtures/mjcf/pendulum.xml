<mujoco model="pendulum">
  <compiler angle="degree" eulerseq="xyz"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="RK4" cone="elliptic" solver="CG"
          iterations="50" impratio="2"/>
  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" friction="0.8 0.01 0.001"/>
    <body name="rod" pos="0 0 1">
      <joint name="hinge" type="hinge" axis="0 1 0" range="-90 90" damping="0.1" armature="0.01"/>
      <geom name="shaft" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.02"/>
      <inertial pos="0 0 -0.25" mass="1.5" diaginertia="0.01 0.01 0.002"/>
      <site name="tip" pos="0 0 -0.5"/>
    </body>
  </worldbody>
</mujoco>
