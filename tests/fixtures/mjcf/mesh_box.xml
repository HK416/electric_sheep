<mujoco model="mesh_box">
  <compiler meshdir="meshes"/>
  <option timestep="0.001"/>
  <asset>
    <mesh name="box" file="box.stl"/>
  </asset>
  <worldbody>
    <camera name="cam" pos="0.25 -1 0.4" fovy="45"/>
    <geom name="floor" type="plane" size="1 1 0.05"/>
    <body name="mesh_box" pos="0 0 0.3">
      <freejoint name="mesh_free"/>
      <geom name="mesh_geom" type="mesh" mesh="box" density="1000"/>
    </body>
    <body name="prim_box" pos="0.5 0 0.3">
      <freejoint name="prim_free"/>
      <geom name="prim_geom" type="box" size="0.05 0.05 0.05" density="1000"/>
    </body>
  </worldbody>
</mujoco>
